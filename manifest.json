{
  "manifest_version": 3,
  "name": "Quiz Copilot",
  "version": "0.4.0",
  "description": "Находит вопросы теста на странице и предлагает ответы через локальный LLM (LM Studio, OpenAI-совместимый API).",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quiz Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-quiz-copilot": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Включить/выключить Quiz Copilot"
    }
  }
}
